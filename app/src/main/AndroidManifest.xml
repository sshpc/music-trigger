<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.musictrigger">
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <application android:allowBackup="true" android:label="Music Trigger" android:supportsRtl="true">
        <activity android:name="com.example.musictrigger.MainActivity" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" android:noHistory="true" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>